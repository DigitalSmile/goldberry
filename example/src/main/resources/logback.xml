<!--
  Logback configuration for the showcase.

  Goldberry itself binds no SLF4J provider (ADR-0023): a library that ships one
  takes the choice away from the application. This file is that choice being
  made, in the one place entitled to make it.

  Logback's own startup chatter is off, because the first thing an application
  should print is its own first line.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Time, level, the last segment of the logger name, message. Short
                 enough to read while a window is opening. -->
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The toolkit at debug: window lifecycle, buffer allocations, backend
         start-up. Frame-by-frame timing is at trace, so
         `-Dgoldberry.log.level=TRACE` is how to find out where a slow frame
         went. -->
    <logger name="io.github.digitalsmile.goldberry" level="${goldberry.log.level:-DEBUG}"/>

    <!-- What the platform's own libraries say about themselves (ADR-0443).
         GLib's messages arrive on `native.glib.<domain>` and SDL's on
         `native.sdl.<category>`, so each is levelled, routed and silenced here
         like anything else rather than being written to stderr from inside C.

         The showcase keeps them at `warn` and shows them, because seeing the
         libayatana-appindicator deprecation arrive as an ordinary log line *is*
         the demonstration. An application that cannot act on it writes

           <logger name="native.glib.libayatana-appindicator" level="off"/>

         and never sees it again, which was impossible before. -->
    <logger name="native" level="${goldberry.log.native.level:-WARN}"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
