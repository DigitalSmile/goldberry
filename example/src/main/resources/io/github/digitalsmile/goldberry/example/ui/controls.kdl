// The **Controls** screen: everything in `core-widgets.md` sec. 3 whose value is
// a *state* rather than a number.
//
// One of five documents behind the gallery's tabs, and the split is the point:
// a screen is a file, so adding one is adding a file and a line, and nothing in
// here knows there is a tab strip above it (ADR-0110).
//
// This carries the interesting half of sec. 9. Every value flows down through
// `bind=` and every gesture flows back up through `change=`, so the file names
// what the application registered and never touches a `Property` (ADR-0063).
column id="screen-controls" {

  text class="screen-title" "Selection"

  // One Tab stop, not two: Tab reaches the group and the arrow keys move inside
  // it. An arrow does not move the tick -- it raises the change, the application
  // sets the property, and the tick follows it back down (ADR-0073, ADR-0063).
  radio-group id="themes" bind="app.theme" change="app.pick-theme" {
    radio value="dark" "Nord dark"
    radio value="light" "Nord light"
  }

  // The same property as the radios above -- so picking a segment moves the
  // radio and vice versa, and Ctrl+T moves both. It shares `radio-group`'s model
  // exactly and is a different widget anyway: the arrows here answer only Left
  // and Right, because a bar has an axis of its own where a group's is its
  // stylesheet's (ADR-0078, ADR-0097).
  segmented id="theme-bar" bind="app.theme" change="app.pick-theme" {
    option value="dark" "Dark"
    option value="light" "Light"
  }

  // And a third control on the same property, which is the whole argument of
  // this screen: none of the three owns the value, so picking from the dropdown
  // moves the radios and the bar, and Ctrl+T moves all three. It writes the
  // same `option` nodes the bar above does -- one node by sec. 3, one record
  // since it had two callers (ADR-0141).
  //
  // The list opens in a window of its own, so it is not clipped by this one --
  // which is what a dropdown near the bottom of a window needs and what an
  // in-window overlay cannot do (ADR-0102, ADR-0140).
  select id="theme-select" bind="app.theme" change="app.pick-theme" placeholder="Choose a theme" {
    option value="dark" "Nord dark"
    option value="light" "Nord light"
  }

  text class="screen-title" "Switches"

  column id="options" {
    checkbox id="prose-toggle" bind="app.prose" change="app.toggle-prose" "Show the prose"

    // Bound to a tri-state property. Clicking it applies Checkbox.Value#toggled(),
    // so a partial selection goes to CHECKED ("all of them") and never back to
    // mixed -- only the application can put it there.
    checkbox id="partly" bind="app.partly" change="app.toggle-partly" "Partly applied"

    // Inert on purpose, so the window shows what 45% opacity looks like on a
    // control that is not a button -- beside two that work.
    checkbox id="unavailable" checked=#true disabled=#true "Not available here"

    // The same property the first checkbox reads. Two controls on one value is
    // the point: drag the switch and the checkbox's tick moves, because neither
    // owns the state and both show what `app.prose` says.
    toggle id="prose-switch" bind="app.prose" change="app.set-prose" "Show the prose (as a switch)"
  }

  text class="screen-title" "Chips"

  // The five semantic variants, and the only place in the toolkit the aurora
  // hues appear at all: design-system.md sec. 1.2 admits them "only with
  // semantic meaning", and a status chip is the first widget whose whole job is
  // to carry one (ADR-0087).
  row id="badges" {
    badge "3"
    badge class="warning" "beta"
    badge class="success" "live"
    badge class="info" "new"
    badge class="danger" "down"
  }
}
