// The **Forms** screen: sec. 4's `text-input`, in every state it has.
//
// A document and not Java, like the Panels screen and for a stronger reason: a
// field holds its own text, its own caret and its own undo stack, so a screen
// full of them needs no more wiring than a screen full of cards -- and the two
// that *are* wired are wired the way every real form is, with `bind=` down and
// `change=` back up.
//
// The three groups are `card`s **side by side** rather than stacked. A form is a
// set of groups, and a card is what makes "these belong together" visible
// without a heading saying it; putting them in columns is what makes the set
// visible in one look rather than one scroll. It is also the arrangement that
// shows a field is a **well** -- content sits *in* it, and the card is what it
// sits on (ADR-0168) -- and it puts every field in a narrow column, which is
// where a single-line field has to work anyway.
column id="screen-forms" {

  row id="form-columns" {

    // Bound *and* reported: the field is the source of what it holds and the
    // model is told, which is sec. 9's "data flows down, events flow up" with
    // the field owning the caret (ADR-0063).
    //
    // This card is the whole argument for that arrangement. `app.name` is
    // written by the handler on every keystroke and read back by the field and
    // by the `text` under it, which is a round trip through the model on every
    // letter. A field that adopted its own echo would put the caret at the end
    // each time; type in the middle of a word and watch it stay where it is.
    card id="named-card" {
      text class="card-title" "A field, and the model"
      text class="caption" "Type here, then click into the middle and keep typing"
      text-input id="name" bind="app.name" change="app.set-name" \
                 placeholder="Your full name" max-length=40
      // Written down because a limit that is not visible reads as a bug: paste
      // into this field enough times and it stops taking characters, which is
      // `max-length` doing exactly what it says and looking like a fault.
      text class="caption" "At most 40 characters — a paste past that is clipped, not refused"
      row id="named-echo" {
        text class="caption" "The model says:"
        text id="name-echo" class="caption" bind="app.name"
      }
    }

    // A filter judges the *result* rather than the keystroke, which is what
    // makes a paste of "80x80" fail and a typed "-" at the start of an integer
    // succeed.
    card id="limits-card" {
      text class="card-title" "What a field refuses"
      text class="caption" "Digits only, at most five"
      text-input id="port" bind="app.port" change="app.set-port" filter="digits" max-length=5

      text class="caption" "Masked, and it will not copy itself out"
      text-input id="secret" password=#true placeholder="Your password"

      text class="caption" "Read-only: a caret and a selection, no edits"
      text-input id="frozen" value="Select this, and copy it" read-only=#true

      text class="caption" "Disabled: out of the tab order entirely"
      text-input id="off" value="Not this one" disabled=#true
    }

    // The one thing a single-line field does that no other control does: it
    // scrolls its own content, by the minimum needed to keep the caret in view,
    // against the width the last frame measured.
    card id="overflow-card" {
      text class="card-title" "Longer than the box"
      text class="caption" "Press End, then Home, and watch the text move under the caret"
      text-input id="long" \
                 value="Yoga laid this out, HarfBuzz shaped it, and Blend2D drew every glyph."

      text class="caption" "And drag across this one to select part of it"
      text-input id="selectable" value="Press, hold and move — a drag is a selection."
    }
  }

  // Three to a row. A fourth column on a 900-point screen gives every field
  // about 200 points, which is narrower than the values people put in them --
  // and sec. 10's `wrap` is not built, so a row that outgrows its width squeezes
  // rather than folding. Three is the number this screen fits; a form that
  // needed a fourth would start a second row, as this one does.
  row id="form-columns-2" {

    // sec. 4's layout contract, wired the way a real form is. Everything here is
    // a **name**: `controller=` names the handle that submits the form,
    // `validator=` names a rule the application wrote, `press=` names the action
    // Save runs. Markup is data, so a document can say which and never what
    // (ADR-0170).
    card id="signup-card" {
      text class="card-title" "A form that refuses"
      text class="caption" "Leave one empty and press Save, or tab out of it"
      form id="signup" class="horizontal" controller="app.signup-form" {
        field label="Name" required=#true {
          text-input bind="app.signup-name" change="app.set-signup-name" \
                     placeholder="Jane Doe"
        }
        // A rule the toolkit does not ship: a port is a number **and** in range,
        // and only the application knows the range. `filter="digits"` refuses
        // the letters as they are typed; this refuses 80 when it is submitted.
        field label="Port" required=#true validator="app.port-rule" {
          text-input bind="app.signup-port" change="app.set-signup-port" \
                     filter="digits" max-length=5 placeholder="8080"
        }
      }
      row id="signup-actions" {
        button class="primary" press="app.submit-signup" "Save"
        text id="signup-status" class="caption" bind="app.signup-status"
      }
    }

    // The same fields with the labels above them, which is `field`'s default and
    // the shape a narrow column wants. One class is the whole difference: a form
    // is where somebody decides that *this form* has a label column, and writing
    // it on every field would be the same decision repeated once per row.
    card id="stacked-card" {
      text class="card-title" "The same form, stacked"
      text class="caption" "`form.horizontal` is a label column; without it, labels sit above"
      form id="stacked" {
        field label="Name" { text-input placeholder="Jane Doe" }
        field label="Port" { text-input placeholder="8080" filter="digits" }
      }
    }

    // Click the label, not the box -- and type into more than one line.
    card id="label-card" {
      text class="card-title" "More than one line"
      text class="caption" "Enter breaks a line; Up and Down keep the column"
      form id="labelled" {
        // sec. 4's multi-line field. It grows as you type, between `rows` and
        // `max-rows`, and scrolls after that -- a height no stylesheet can set,
        // because it is a function of how many lines the text wrapped into.
        field label="Bio" { text-area bind="app.bio" change="app.set-bio" rows=3 max-rows=6 }
        field label="Click this label" { text-input placeholder="…the caret lands here" }
      }
    }
  }
}
