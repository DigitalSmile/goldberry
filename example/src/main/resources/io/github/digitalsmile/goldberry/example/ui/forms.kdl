// The **Forms** screen's markup half: §4 entire — `text-input`, `text-area`,
// `code-input`, `date-picker`, `time-picker`, `color-picker`, `field` and `form`,
// in every state each of them has.
//
// A document for the Panels screen's reason and a stronger one: a field holds its
// own text, caret and undo stack, so a screen full of them needs no more wiring
// than a screen full of cards. The two that *are* wired are wired the way a real
// form is — `bind=` down and `change=` back up — which is what makes this screen
// the demonstration that a field does not adopt the echo of its own keystroke.
//
// The four cards this file cannot write are
// [io.github.digitalsmile.goldberry.example.ui.Choosers]' three and
// [io.github.digitalsmile.goldberry.example.ui.TextStylingCard]: a `multiple`
// holds a *set* the application edits, an `autocomplete` renders whatever options
// it is handed *back*, a `tree`'s model is nodes with suppliers under them, and a
// class set computed from seven toggles is a value rather than an attribute a
// document can write. All four are channels a document does not have (ADR-0182,
// ADR-0183, ADR-0184, ADR-0324).
masonry id="forms-wall" columns=3 {

  card id="named-card" class="wall-card" {
    text class="card-title" "A field, and the model"
    text class="caption" "Type here, then click into the middle and keep typing"
    text-input id="name" bind="app.name" change="app.set-name" \
               placeholder="Your name in the Red Book" max-length=40
    text class="caption" "At most 40 characters — a paste past that is clipped, \
not refused"
    row id="named-echo" {
      text class="caption" "The Book says:"
      text id="name-echo" class="caption" bind="app.name"
    }
  }

  card id="limits-card" class="wall-card" {
    text class="card-title" "What a field refuses"
    text class="caption" "Digits only, at most five — the palantír's port"
    text-input id="port" bind="app.port" change="app.set-port" filter="digits" max-length=5
    text class="caption" "Masked, and it will not copy itself out"
    text-input id="secret" password=#true placeholder="The word that opens the doors"
    text class="caption" "Read-only: a caret and a selection, no edits"
    text-input id="frozen" value="Copied from the Red Book, not written into it" read-only=#true
    text class="caption" "Disabled: out of the tab order entirely"
    text-input id="off" value="Speak, friend" disabled=#true
  }

  card id="overflow-card" class="wall-card" {
    text class="card-title" "Longer than the box"
    text class="caption" "Press End, then Home, and watch the text move under the caret"
    text-input id="long" \
               value="Eighteen hundred leagues of road, and a field that is not wide enough for it."
    text class="caption" "And drag across this one to select part of it"
    text-input id="selectable" value="Press, hold and move — a drag is a selection."
  }

  card id="signup-card" class="wall-card" {
    text class="card-title" "A form that refuses"
    text class="caption" "Leave one empty and press Enlist, or tab out of it"
    form id="signup" class="horizontal" controller="app.signup-form" {
      field label="Name" required=#true {
        text-input bind="app.signup-name" change="app.set-signup-name" \
                   placeholder="Meriadoc Brandybuck"
      }
      field label="Palantír" required=#true validator="app.port-rule" {
        text-input bind="app.signup-port" change="app.set-signup-port" \
                   filter="digits" max-length=5 placeholder="8080"
      }
      field class="actions" {
        button class="primary" press="app.submit-signup" "Enlist"
        text id="signup-status" class="caption" bind="app.signup-status"
      }
    }
  }

  card id="stacked-card" class="wall-card" {
    text class="card-title" "The same form, stacked"
    text class="caption" "`form.horizontal` is a label column; without it, labels \
sit above"
    form id="stacked" {
      field label="Name" { text-input placeholder="Peregrin Took" }
      field label="Palantír" { text-input placeholder="8080" filter="digits" }
    }
  }

  card id="date-card" class="wall-card" {
    text class="card-title" "A date, typed or picked"
    text class="caption" "The field is the source of truth — type into it, or \
press the chevron and use the grid"
    date-picker id="departure" bind="trip.date" change="trip.set-date" \
                month="2026-09" min="2026-09-01" max="2026-12-31" \
                placeholder="When are you leaving?"
    text id="trip-status" class="caption" bind="trip.status"
    text class="caption" "Nothing before September or after December will parse, \
and nothing outside them can be pressed"
    text class="caption" "In the grid: arrows move a day, PgUp and PgDn a month, \
Shift with either a year"
    text class="caption" "And what time it leaves — the same control with wheels \
instead of a grid"
    time-picker id="departure-time" bind="trip.time" change="trip.set-time" \
                min="06:00" max="22:00" placeholder="Boarding time"
    text id="trip-time-status" class="caption" bind="trip.time-status"
    text class="caption" "In the wheels: Up and Down turn one, Left and Right \
choose which"
  }

  card id="paint-card" class="wall-card" {
    text class="card-title" "A colour, dragged or typed"
    text class="caption" "The hex field is the source of truth — the plane, the \
ramps and the presets all write into it"
    row id="paint-row" {
      color-picker id="paint" bind="paint.colour" change="paint.set-colour"
      text id="paint-status" class="caption" bind="paint.status"
    }
    text class="caption" "Arrows move the plane cursor by one step, Shift by ten"
    text class="caption" "And with an alpha ramp, which is off by default because \
a picker without one must not report a translucent value"
    color-picker id="paint-alpha" alpha=#true value="#bf616a80"
  }

  card id="code-card" class="wall-card" {
    text class="card-title" "Six boxes, one value"
    text class="caption" "Type digits, or paste `123 456` — the spaces are not \
boxes, so they are dropped"
    code-input id="one-time-code" length=6 type="digits" \
               bind="app.code" change="app.set-code" complete="app.code-complete"
    text id="code-status" class="caption" bind="app.code-status"
    text class="caption" "Backspace clears the box before the ring; Escape starts \
the code again"
    text class="caption" "And the same thing an authenticator draws"
    code-input id="masked-code" length=6 type="digits" mask=#true
    text class="caption" "An odd length is a flat row — the wider gap at the \
midpoint only exists when there is one"
    code-input id="alnum-code" length=5 type="alnum"
  }

  card id="label-card" class="wall-card" {
    text class="card-title" "More than one line"
    text class="caption" "Enter breaks a line; Up and Down keep the column"
    form id="labelled" {
      field label="The Red Book" { text-area bind="app.bio" change="app.set-bio" rows=3 max-rows=6 }
      field label="Click this label" { text-input placeholder="…the caret lands here" }
    }
  }
}
