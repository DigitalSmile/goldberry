// The **Panels** screen: §5's containers, in the wall of cards a settings window
// is actually made of.
//
// The purest case for a document there is, and the only screen in the gallery
// with no value on it at all — nothing here holds one, they are all containers,
// so it needs no `bind=`, no `change=` and no Java at all. The two widgets on it
// that do have state keep it themselves.
//
// The root is a `masonry` for the reason every screen's is: a card is as tall as
// its contents, a `split-pane` is not the height of a `statistic`, and equal rows
// would put the short ones in acres of empty surface (ADR-0196, ADR-0222).
//
// Nothing here styles the widgets themselves: `card`, `group-box`, `statistic`,
// `skeleton`, `collapse` and `carousel` all carry their own appearance in
// `controls.css`, the way every other control in this catalog does. What is here
// is the screen's *layout*, which is an application's business.
masonry id="panels-wall" columns=2 {

  // The point of the card: a `panel` and a `card` beside each other at the same
  // size is the only way to see an elevation expressed as contrast rather than
  // as a shadow -- a card on its own looks exactly like a panel (ADR-0164).
  card id="surface-card" class="wall-card" {
    text class="card-title" "Surfaces"
    row id="surfaces" {
      panel class="surface-demo" {
        text class="caption" "panel"
        text "The building block. No elevation: whatever the theme says a \
surface is, and nothing else."
      }
      card class="surface-demo" {
        text class="caption" "card"
        text "Raised by contrast rather than by a shadow — there is no \
`box-shadow` in the subset, and nothing here paints outside its own rectangle."
      }
      card class="surface-demo interactive" {
        text class="caption" "card.interactive"
        text "The optional hover-elevation. Opt-in, because a card that lit up \
under the pointer would promise it does something."
      }
    }
  }

  // The other panel §5 gives an application, and the reason this screen is not
  // six cards: a `group-box` is a *titled* frame, so a set of settings reads as
  // one thing with a name on it rather than as a card that happens to open with
  // bold text.
  group-box id="company-box" class="wall-card" title="The Company" {
    row class="setting" { text "Ring-bearer"; spacer; text class="caption" "Frodo Baggins" }
    row class="setting" { text "Guide"; spacer; text class="caption" "Gandalf the Grey" }
    row class="setting" { text "Sworn sword"; spacer; text class="caption" "Aragorn" }
    row class="setting" { text "Provisions"; spacer; text class="caption" "Lembas, 30 days" }
  }

  group-box id="untitled-box" class="wall-card" {
    text "A group box with no title is still a frame — and leaves no gap where \
the heading would have been, because the title node is absent rather than \
present and empty."
  }

  card id="numbers-card" class="wall-card" {
    text class="card-title" "Numbers"
    // Each statistic takes an equal share of the row rather than only as much as
    // its own number needs -- otherwise a four-digit figure beside a one-digit
    // one puts them at wildly different places and they stop reading as a set.
    row id="numbers" {
      statistic label="Leagues walked" value="1,795" delta="+42" direction="up"
      statistic label="Days from Rivendell" value="93" unit="d" delta="-2" direction="down"
      statistic label="Companions lost" value="1" delta="Gandalf"
    }
  }

  card id="loading-card" class="wall-card" {
    text class="card-title" "While the map is unrolled"
    column class="loading-block" {
      text class="caption" "shape=title, then shape=text lines=3"
      skeleton shape="title"
      skeleton shape="text" lines=3
    }
    column class="loading-block" {
      text class="caption" "shape=circle beside a heading and two lines"
      row class="loading-row" {
        skeleton shape="circle"
        column class="loading-lines" {
          skeleton shape="title"
          skeleton shape="text" lines=2
        }
      }
    }
  }

  card id="split-card" class="wall-card" {
    text class="card-title" "Two panes and a divider"
    split-pane id="demo-split" first-min=120 second-min=140 collapsible=#true {
      panel class="split-demo" {
        text class="caption" "The map"
        text "Tab to the divider and use the arrows, or Enter to collapse."
      }
      panel class="split-demo" {
        text class="caption" "The road"
        text "This one takes whatever is left, which is why only the first is \
given a size."
      }
    }
  }

  card id="carousel-card" class="wall-card" {
    text class="card-title" "One stage at a time"
    carousel id="demo-carousel" {
      panel class="slide" {
        text class="caption" "Stage 1 of 3 — Bag End"
        text "The arrows move between slides when the strip has focus. The dots \
go straight to one."
      }
      panel class="slide" {
        text class="caption" "Stage 2 of 3 — Rivendell"
        text "Only this slide exists right now. The other two were dropped when \
you left them."
      }
      panel class="slide" {
        text class="caption" "Stage 3 of 3 — Moria"
        text "Next is greyed here, because this carousel does not loop."
      }
    }
  }

  card id="collapse-card" class="wall-card" {
    text class="card-title" "Folding away"
    collapse title="The Council's terms" {
      row class="setting" { text "Bearers"; spacer; text class="caption" "1" }
      row class="setting" { text "Companions"; spacer; text class="caption" "8" }
    }
    collapse title="Already open" open=#true {
      text "Open it and shut it: the two rows above are built when the section \
opens and dropped when it closes, which is what keeps a collapsed panel from \
holding subscriptions for content nobody can see."
    }
    collapse title="Nothing in here" {
      text "An empty section is still a section."
    }
  }

  card id="accordion-card" class="wall-card" {
    text class="card-title" "One section at a time"
    column accordion=#true id="demo-accordion" {
      collapse title="The Shire" {
        row class="setting" { text "Second breakfast"; spacer; text class="caption" "Kept" }
        row class="setting" { text "Pipe-weed"; spacer; text class="caption" "Longbottom Leaf" }
      }
      collapse title="Rivendell" {
        row class="setting" { text "Council"; spacer; text class="caption" "Held" }
        row class="setting" { text "Sword reforged"; spacer; text class="caption" "Andúril" }
      }
      collapse title="Moria" {
        row class="setting" { text "Doors"; spacer; text class="caption" "Mellon" }
      }
    }
  }
}
