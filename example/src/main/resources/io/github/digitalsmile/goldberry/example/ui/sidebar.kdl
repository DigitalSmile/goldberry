// The sidebar: the theme picker, the status chips, the bound status line, and
// every control in the window.
//
// This is the document that carries the interesting half of sec. 9. Every value
// flows down through `bind=` and every gesture flows back up through `change=`,
// so the file names what the application registered and never touches a
// `Property` (ADR-0063). Nothing here is a widget the toolkit had to be told
// about specially: `radio-group`, `slider` and `knob` are registry entries like
// `row` is.
column id="sidebar" {

  // One Tab stop, not two: Tab reaches the group and the arrow keys move inside
  // it. An arrow does not move the tick -- it raises the change, the application
  // sets the property, and the tick follows it back down (ADR-0073, ADR-0063).
  radio-group id="themes" bind="app.theme" change="app.pick-theme" {
    radio value="dark" "Nord dark"
    radio value="light" "Nord light"
  }

  // The eleventh control, on the **same property as the radios above** -- so
  // picking a segment moves the radio and vice versa, and Ctrl+T moves both.
  // It shares `radio-group`'s model exactly and is a different widget anyway:
  // the arrows here answer only Left and Right, because a bar has an axis of its
  // own where a group's is its stylesheet's (ADR-0078, ADR-0097).
  segmented id="theme-bar" bind="app.theme" change="app.pick-theme" {
    option value="dark" "Dark"
    option value="light" "Light"
  }

  // The five semantic variants, and the only place in the toolkit the aurora
  // hues appear at all: design-system.md sec. 1.2 admits them "only with
  // semantic meaning", and a status chip is the first widget whose whole job is
  // to carry one (ADR-0087).
  row id="badges" {
    badge "3"
    badge class="warning" "beta"
    badge class="success" "live"
    badge class="info" "new"
    badge class="danger" "down"
  }

  // Bound and never passed a value: the environment probe sets the property from
  // a virtual thread and this line updates itself (ADR-0020, ADR-0062).
  text id="status" class="caption" bind="app.status"

  column id="options" {
    checkbox id="prose-toggle" bind="app.prose" change="app.toggle-prose" "Show the prose"

    // Bound to a tri-state property. Clicking it applies Checkbox.Value#toggled(),
    // so a partial selection goes to CHECKED ("all of them") and never back to
    // mixed -- only the application can put it there.
    checkbox id="partly" bind="app.partly" change="app.toggle-partly" "Partly applied"

    // Inert on purpose, so the window shows what 45% opacity looks like on a
    // control that is not a button -- beside two that work.
    checkbox id="unavailable" checked=#true disabled=#true "Not available here"

    // The same property the first checkbox reads. Two controls on one value is
    // the point: drag the switch and the checkbox's tick moves, because neither
    // owns the state and both show what `app.prose` says.
    toggle id="prose-switch" bind="app.prose" change="app.set-prose" "Show the prose (as a switch)"

    // sec. 3's two optional halves -- tick marks and a value label -- and the
    // reason there is no `text` under this line: the application used to format
    // "Gain 40%" into a second property and the control says it now (ADR-0080).
    slider id="gain" min=0 max=100 step=5 ticks=5 format="%.0f%%" \
           bind="app.gain" change="app.set-gain"

    // The tenth control, on the **same property** as the slider -- so dragging
    // one turns the other. It is also the only place two controls with different
    // *kinds* of gesture meet: the slider's value is where the pointer is along
    // its track, and this one's is where it started plus how far you have dragged
    // (ADR-0089).
    row id="knobs" {
      knob id="gain-knob" min=0 max=100 step=5 detents=5 bind="app.gain" change="app.set-gain"
      text id="gain-knob-label" class="caption" "Gain, again"
    }

    // Reports rather than asks: the bar follows the property the slider sets, and
    // the spinner is the reason this window no longer goes idle -- a mounted
    // spinner asks for another frame for as long as it is there (ADR-0081).
    column id="task" {
      row id="busy" {
        spinner
        text id="busy-label" "Working"
      }
      progress max=100 bind="app.gain"
    }
  }
}
