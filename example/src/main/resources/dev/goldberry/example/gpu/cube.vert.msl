#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Transform
{
    float4x4 clip;
    float4x4 model;
    float4 light;
};

struct main0_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_Transform& Transform [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_TEXCOORD0 = float4(in.in_var_TEXCOORD2.xyz * (0.25 + (0.75 * fast::clamp(dot(fast::normalize(in.in_var_TEXCOORD1 * float3x3(Transform.model[0].xyz, Transform.model[1].xyz, Transform.model[2].xyz)), fast::normalize(Transform.light.xyz)), 0.0, 1.0))), in.in_var_TEXCOORD2.w);
    out.gl_Position = float4(in.in_var_TEXCOORD0, 1.0) * Transform.clip;
    return out;
}

