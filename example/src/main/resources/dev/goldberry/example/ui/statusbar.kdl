// The footer along the bottom of the window: **what this run cost**.
//
// Four bound readings, all of them `bind=` and no Java at all, which is why it
// is a document. The startup line comes off a background job's continuation
// and the count off the Buttons screen; neither knows this file exists, and
// this file names no widget that either of them holds.
row id="bar" {

  // The leagues walked, in the one place on screen that is never scrolled away.
  badge id="clicks" class="accent" bind="app.clicks"

  // How long this process took to put a window up, and what it found when it
  // looked around. Two readings and not one: they answer different questions and
  // they arrive at different times, so a single line would flicker between them.
  text id="startup" class="caption" bind="app.startup"
  text id="status" class="caption" bind="app.status"

  // `spacer`, which is `flex-grow: 1` with a name. A document has no stylesheet
  // of its own to put a margin in, so markup's answer to "push the rest to the
  // far end" is a node.
  spacer

  // Where the frames go: through the GPU, or on the CPU and why. A badge, so it
  // reads as a fact about this run rather than as one more caption, and bound,
  // so it changes when the window does: a GPU that fails, or `auto` taking the
  // GPU for a layer.
  badge id="presentation" class="info" bind="app.presentation"
}
