#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Depth
{
    float w;
    packed_float3 padding;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_Depth& Depth [[buffer(0)]], texture3d<float> volume [[texture(0)]], sampler volumeSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = volume.sample(volumeSmplr, float3(in.in_var_TEXCOORD0, Depth.w));
    return out;
}

