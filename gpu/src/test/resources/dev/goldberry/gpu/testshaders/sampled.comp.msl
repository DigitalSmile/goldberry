#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

kernel void main0(texture2d<float> image [[texture(0)]], texture2d<float, access::write> colours [[texture(1)]], sampler imageSmplr [[sampler(0)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    colours.write(image.sample(imageSmplr, float2((float(gl_GlobalInvocationID.x) + 0.5) * 0.25, 0.5), level(0.0)), uint2(gl_GlobalInvocationID.xy));
}

