#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Direction
{
    packed_float3 direction;
    float padding;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

fragment main0_out main0(constant type_Direction& Direction [[buffer(0)]], texturecube<float> cube [[texture(0)]], sampler cubeSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = cube.sample(cubeSmplr, float3(Direction.direction));
    return out;
}

