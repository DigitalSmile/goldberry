#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Colour
{
    float4 colour;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

fragment main0_out main0(constant type_Colour& Colour [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = Colour.colour;
    return out;
}

