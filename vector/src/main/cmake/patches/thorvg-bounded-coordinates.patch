 /* External Class Implementation                                        */
 /************************************************************************/
 
+/* Goldberry: coordinates the rasterizer can hold. Its cells are 24.8 fixed
+   point in int32, so past about four million pixels the difference of two
+   points overflows, and a line's cell walk overshoots its end and runs until
+   the counter wraps: a document whose <use> scaled a star by -2^31 drew for
+   hours. A point is clamped to +/-2^21 pixels, where every difference fits, and
+   one that is not a number goes to the origin rather than through a float to
+   int conversion that is undefined. The picture is at most 8192 pixels a side,
+   so geometry this far out is off it; an edge from inside to a clamped point
+   changes angle, an axis-aligned one does not. */
+static constexpr float COORD_LIMIT = 2097152.0f;
+
+static inline float _bounded(float v)
+{
+    if (v > COORD_LIMIT) return COORD_LIMIT;
+    if (v > -COORD_LIMIT) return v;
+    return (v != v) ? 0.0f : -COORD_LIMIT;
+}
+
+
