# Exported symbols of libgoldberry -- the complete native surface.
#
# Everything is compiled with hidden visibility and the statically linked
# upstreams are excluded from re-export, so a symbol reaches Java only by being
# listed here. The build turns this file into a linker version script on Linux,
# an -exported_symbols_list on macOS, and a .def on Windows, and forces each
# symbol to be pulled out of its static archive with -u.
#
# This file is the mirror of the Java binding registry: a symbol bound in Java
# but missing here fails at load time with an unresolved-symbol error, and a
# symbol here that nothing binds is dead weight. Keeping the two in step is the
# same discipline ADR-0010 applies to struct layouts.
#
# Blank lines and #-comments are ignored. One symbol per line.
#
# ASCII ONLY, including in comments. CMake's file(STRINGS) extracts runs of
# printable ASCII, so a non-ASCII byte splits the line -- a comment containing
# one returns its tail as a separate element that no longer starts with '#', and
# the parser hands that fragment to the linker as a symbol name. The build now
# rejects anything that is not a valid C identifier, but keeping this file ASCII
# avoids the problem at its source. (Hence "sec. 4" rather than the section sign
# used elsewhere in the docs.)

# --- libgoldberry's own surface ---------------------------------------------
goldberry_abi_version
goldberry_layout_table
goldberry_layout_count

# Calls a YGMeasureFunc upcall stub and reports what the struct-by-value return
# delivered. See sec. 3.1 and ADR-0017.
goldberry_probe_measure

# --- SDL3 (sec. 4, backend SPI) ----------------------------------------------
# Lifecycle, error and version. Enough to prove SDL3 is reachable through this
# list and to report which SDL is linked in; windowing follows.
SDL_Init
SDL_InitSubSystem
SDL_QuitSubSystem
SDL_WasInit
SDL_Quit
SDL_GetError
SDL_ClearError
SDL_GetVersion
SDL_GetRevision
SDL_GetCurrentVideoDriver
SDL_SetHint

# Windowing and the CPU present path (sec. 4, sec. 5).
SDL_CreateWindow
SDL_DestroyWindow
SDL_ShowWindow
SDL_SetWindowTitle
SDL_GetWindowSize
SDL_GetWindowSizeInPixels
SDL_GetWindowDisplayScale
SDL_GetDisplayForWindow
SDL_GetCurrentDisplayMode
SDL_GetWindowID
SDL_GetWindowSurface
SDL_UpdateWindowSurfaceRects
SDL_DestroyWindowSurface

# Event pumping, and SDL_PushEvent for the cross-thread wakeup.
SDL_PollEvent
SDL_WaitEventTimeout
SDL_PushEvent
SDL_PumpEvents

# The event watch (ADR-0060). Windows and macOS run a modal loop while a window
# is being resized and do not return from event pumping until the drag ends; a
# watch is called from inside that pump, and is the only place a frame can be
# drawn while it is running.
SDL_AddEventWatch
SDL_RemoveEventWatch

# Cursors (sec. 7.3). Process-global in SDL: SDL_SetCursor changes what the mouse
# looks like, and the pointer is over one window at a time.
SDL_CreateSystemCursor
SDL_SetCursor
SDL_DestroyCursor
SDL_ShowCursor
SDL_HideCursor

# --- Blend2D (sec. 5, paint & raster) ----------------------------------------
# The image and context surface: enough to rasterize a frame into the buffer the
# platform lends us. Paths, gradients, strokes and text follow. See ADR-0031.
#
# Note the snake_case: this revision of Blend2D renamed its C API from
# blImageInit to bl_image_init. A symbol list copied from an older example fails
# to link, which is one more reason the ref is a commit SHA (ADR-0030).

# Which Blend2D is linked in.
bl_runtime_query_info

# Images. Only the external-data constructor is bound: Goldberry never asks
# Blend2D to allocate pixels, it hands over the ones it already has.
bl_image_init_as_from_data
bl_image_destroy
bl_image_get_data

# Rendering context lifecycle.
bl_context_init_as
bl_context_end
bl_context_destroy
bl_context_flush

# State: the display scale reaches the rasterizer as a transform.
bl_context_apply_transform_op
bl_context_set_comp_op

# Drawing.
bl_context_clear_all
bl_context_fill_all_rgba32
bl_context_fill_rect_d_rgba32

# Fonts, and the glyphs HarfBuzz chose (sec. 6, ADR-0034). Bytes -> data ->
# face -> font, three objects for the same reason HarfBuzz needs three: the
# file, the typeface, and the size it is used at are different things. Only the
# from-data constructors are bound; Goldberry never gives Blend2D a file path.
bl_font_data_init
bl_font_data_create_from_data
bl_font_data_destroy
bl_font_face_init
bl_font_face_create_from_data
bl_font_face_destroy
bl_font_init
bl_font_create_from_face
bl_font_destroy

# Where the baseline goes. Scaled by the font's size, unlike the design metrics
# on the face, which is what makes them the ones a paint pass wants.
bl_font_get_metrics

# The call the whole font chain exists for.
bl_context_fill_glyph_run_d_rgba32

# Paths, and the icons drawn with them (sec. 6.3, ADR-0043). Lucide's 1544 icons
# are SVG path data in a 24x24 box, so what is bound is the set of path commands
# SVG has and no more: the curve constructors, the elliptic arc that `A` maps
# onto directly, and the two "smooth" forms that `S` and `T` map onto. Binding
# fewer would mean reimplementing them in Java against Blend2D's own conventions
# for the reflected control point, which is exactly the arithmetic a rasterizer
# should be trusted with.
bl_path_init
bl_path_destroy
bl_path_reset
bl_path_get_size
bl_path_move_to
bl_path_line_to
bl_path_quad_to
bl_path_cubic_to
bl_path_smooth_quad_to
bl_path_smooth_cubic_to
bl_path_elliptic_arc_to
bl_path_close

# An icon is stroked, not filled: Lucide draws 2px round strokes rather than
# filled shapes, so the stroke options are as much a part of the icon path as
# the geometry is. Fill is bound too, for the shapes that are filled.
bl_context_set_stroke_width
bl_context_set_stroke_caps
bl_context_set_stroke_join
bl_context_fill_path_d_rgba32
bl_context_stroke_path_d_rgba32

# --- Yoga (sec. 5, layout) ---------------------------------------------------
# The node API, bound in the `yoga` package. YGSize and the measure callback are
# above -- they were proven first (ADR-0017), and this is what finally drives
# them from a real layout pass.

# Config: the point scale factor is what makes fractional DPI land on physical
# pixels, and web defaults are what make Yoga agree with CSS. See ADR-0029.
YGConfigNew
YGConfigFree
YGConfigSetPointScaleFactor
YGConfigGetPointScaleFactor
YGConfigSetUseWebDefaults
YGConfigGetUseWebDefaults

# Node lifecycle and tree structure.
YGNodeNew
YGNodeNewWithConfig
YGNodeFree
YGNodeInsertChild
YGNodeRemoveChild
YGNodeRemoveAllChildren
YGNodeGetChildCount
YGNodeSetMeasureFunc
YGNodeHasMeasureFunc
YGNodeMarkDirty
YGNodeIsDirty
YGNodeGetHasNewLayout
YGNodeSetHasNewLayout
YGNodeCalculateLayout

# Style: the enum-valued properties.
YGNodeStyleSetDirection
YGNodeStyleSetFlexDirection
YGNodeStyleSetJustifyContent
YGNodeStyleSetAlignContent
YGNodeStyleSetAlignItems
YGNodeStyleSetAlignSelf
YGNodeStyleSetPositionType
YGNodeStyleSetFlexWrap
YGNodeStyleSetOverflow
YGNodeStyleSetDisplay

# Style: plain numbers.
YGNodeStyleSetFlexGrow
YGNodeStyleSetFlexShrink
YGNodeStyleSetAspectRatio
YGNodeStyleSetBorder

# Style: lengths. Yoga splits each property into points, percent and -- where
# the property admits it -- auto, which StyleLength puts back together.
YGNodeStyleSetWidth
YGNodeStyleSetWidthPercent
YGNodeStyleSetWidthAuto
YGNodeStyleSetHeight
YGNodeStyleSetHeightPercent
YGNodeStyleSetHeightAuto
YGNodeStyleSetMinWidth
YGNodeStyleSetMinWidthPercent
YGNodeStyleSetMinHeight
YGNodeStyleSetMinHeightPercent
YGNodeStyleSetMaxWidth
YGNodeStyleSetMaxWidthPercent
YGNodeStyleSetMaxHeight
YGNodeStyleSetMaxHeightPercent
YGNodeStyleSetFlexBasis
YGNodeStyleSetFlexBasisPercent
YGNodeStyleSetFlexBasisAuto
YGNodeStyleSetPosition
YGNodeStyleSetPositionPercent
YGNodeStyleSetMargin
YGNodeStyleSetMarginPercent
YGNodeStyleSetMarginAuto
YGNodeStyleSetPadding
YGNodeStyleSetPaddingPercent
YGNodeStyleSetGap
YGNodeStyleSetGapPercent

# The computed layout -- the whole point of the rest of it.
YGNodeLayoutGetLeft
YGNodeLayoutGetTop
YGNodeLayoutGetWidth
YGNodeLayoutGetHeight
YGNodeLayoutGetMargin
YGNodeLayoutGetBorder
YGNodeLayoutGetPadding
YGNodeLayoutGetDirection
YGNodeLayoutGetHadOverflow

# --- HarfBuzz (sec. 6, text) -------------------------------------------------
# Shaping: UTF-16 in (which is what a Java String already is), glyph ids and
# positions out. See ADR-0032.

# Which HarfBuzz is linked in.
hb_version

# A font's bytes -> a face -> a font. Three objects because HarfBuzz separates
# the file, the typeface, and the sizing of it.
hb_blob_create
hb_blob_destroy
hb_face_create
hb_face_destroy
hb_face_get_empty
# The units advances come back in when nothing sets a scale -- and therefore
# the units Blend2D's font matrix expects. See ADR-0034.
hb_face_get_upem
hb_font_create
hb_font_destroy
hb_font_set_scale

# The buffer: the run of text being shaped, and afterwards the glyphs.
hb_buffer_create
hb_buffer_destroy
hb_buffer_reset
hb_buffer_add_utf16
hb_buffer_guess_segment_properties
hb_buffer_set_direction
hb_buffer_get_direction
hb_buffer_set_script
hb_buffer_set_language
hb_buffer_get_length
hb_buffer_get_glyph_infos
hb_buffer_get_glyph_positions
hb_script_from_string
hb_language_from_string

# The one call the rest of it exists for.
hb_shape

