 static void on_stream_param_changed(void *data, uint32_t id, const struct spa_pod *param)
 {
+    // Goldberry patch: answer the negotiated format with the buffers this
+    // stream takes, as PipeWire's own video-capture example does. Without a
+    // Buffers param PipeWire's V4L2 source refuses the stream ("use input
+    // buffers: Invalid argument"), it never reaches STREAMING, and the camera's
+    // permission is never granted. Memory this process can map, one block a
+    // buffer; the size and stride are the source's.
+    SDL_Camera *device = data;
+    uint8_t buffer[256];
+    struct spa_pod_builder b = SPA_POD_BUILDER_INIT(buffer, sizeof(buffer));
+    const struct spa_pod *params[1];
+
+    if (param == NULL || id != SPA_PARAM_Format || device == NULL || device->hidden == NULL) {
+        return;
+    }
+    params[0] = spa_pod_builder_add_object(&b,
+                SPA_TYPE_OBJECT_ParamBuffers, SPA_PARAM_Buffers,
+                        SPA_PARAM_BUFFERS_buffers, SPA_POD_CHOICE_RANGE_Int(8, 2, 16),
+                        SPA_PARAM_BUFFERS_blocks, SPA_POD_Int(1),
+                        SPA_PARAM_BUFFERS_dataType, SPA_POD_CHOICE_FLAGS_Int((1 << SPA_DATA_MemPtr) | (1 << SPA_DATA_MemFd)));
+    PIPEWIRE_pw_stream_update_params(device->hidden->stream, params, 1);
 }
 
 static void on_add_buffer(void *data, struct pw_buffer *buffer)
@@ -571,8 +602,11 @@ static void PIPEWIRECAMERA_CloseDevice(SDL_Camera *device)
 
 static bool PIPEWIRECAMERA_WaitDevice(SDL_Camera *device)
 {
+    // Goldberry patch, as upstream's main branch has it: wait at most a
+    // second, so a stream that never delivers cannot hold SDL_CloseCamera,
+    // which joins this thread, for ever.
     PIPEWIRE_pw_thread_loop_lock(hotplug.loop);
-    PIPEWIRE_pw_thread_loop_wait(hotplug.loop);
+    PIPEWIRE_pw_thread_loop_timed_wait(hotplug.loop, 1);
     PIPEWIRE_pw_thread_loop_unlock(hotplug.loop);
     return true;
 }
