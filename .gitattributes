# Text is LF in every working tree, on every platform.
#
# build-logic's drift guards read the workflows and build scripts as text, and a
# Windows runner checks out with core.autocrlf=true unless told otherwise: the
# first Windows run split showcase.yml on a blank line, found none, and failed
# with an index error rather than a message (ADR-0338). The guards normalise
# what they read as well; this keeps the shell scripts and the launcher honest.
* text=auto eol=lf

# Windows batch files are read by cmd.exe, which wants CRLF.
*.bat text eol=crlf
